# ---- SPA (Vite expone al navegador SOLO las variables con prefijo VITE_) ----
# NUNCA poner secretos aqui: todo lo que empiece con VITE_ termina en el bundle.

VITE_APP_NAME=web-condominio

# URL base del API Gateway que enruta a los 5 microservicios
VITE_API_GATEWAY_URL=https://XXXXXXXX.execute-api.us-east-1.amazonaws.com/dev

# Rutas de cada microservicio detras del API Gateway
VITE_API_RESIDENTES=/residentes
VITE_API_PAGOS=/pagos
VITE_API_INCIDENCIAS=/incidencias
VITE_API_FICHA=/ficha
VITE_API_ANALITICO=/analitico
