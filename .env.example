# ---- SPA (Vite expone al navegador SOLO las variables con prefijo VITE_) ----
# NUNCA poner secretos aqui: todo lo que empiece con VITE_ termina en el bundle.

VITE_APP_NAME=condominios.net

# Modo de acceso a los microservicios:
#   proxy  -> /api/<servicio>/<ruta>   (usar SIEMPRE en Amplify)
#   direct -> http://<host>:<puerto>   (solo para desarrollo local)
VITE_API_MODE=proxy

# URL base del balanceador, SIN puerto y SIN barra final.
# En modo proxy solo la usa el servidor de desarrollo de Vite.
VITE_API_BASE_URL=http://alb-condominio-678852222.us-east-1.elb.amazonaws.com

# Puerto publicado de cada microservicio (rango del curso: 9000-12000)
VITE_PORT_RESIDENTES=9001
VITE_PORT_PAGOS=9002
VITE_PORT_INCIDENCIAS=9003
VITE_PORT_FICHA=9004
VITE_PORT_ANALITICO=9005
VITE_PORT_USUARIOS=9006

# Clave donde la SPA guarda el token devuelto por el login
VITE_TOKEN_STORAGE_KEY=condominio_token
