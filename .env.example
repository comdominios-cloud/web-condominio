# ---- SPA (Vite expone al navegador SOLO las variables con prefijo VITE_) ----
# NUNCA poner secretos aqui: todo lo que empiece con VITE_ termina en el bundle.

VITE_APP_NAME=web-condominio

# URL base del balanceador que reparte a las 2 VM de produccion gemelas
VITE_API_BASE_URL=http://IP-DEL-BALANCEADOR

# Puerto publicado de cada microservicio (rango asignado por el curso: 9000-12000)
VITE_PORT_RESIDENTES=9001
VITE_PORT_PAGOS=9002
VITE_PORT_INCIDENCIAS=9003
VITE_PORT_FICHA=9004
VITE_PORT_ANALITICO=9005

# Clave donde la SPA guarda el token devuelto por POST /auth/login
VITE_TOKEN_STORAGE_KEY=condominio_token
